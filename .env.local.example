# Copy this file to .env.local (which is gitignored) and fill in real values.
# .env.local is loaded automatically by Next.js for local development.
#
# Other environments: copy .env.uat.local.example → .env.uat.local and
# .env.prod.local.example → .env.prod.local, then use the matching config in
# .vscode/launch.json (Run and Debug).
#
# If the password contains #, ?, &, or @, URL-encode it in DATABASE_URL:
#   node -e "console.log(encodeURIComponent(process.argv[1]))" 'raw-password'

# PostgreSQL connection string. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DB
# The user must have SELECT on:
#   - wisecode_app.food_expressions
#   - wisecode_app.food_expression_foods
#   - wisecode_app.food_expression_value_interpretations
#   - wisecode_app.food_normalized_scores  (created by the WISEintelligence
#                                           refresh script — see PROTOTYPE.md)
#   - wisecode_gold.food
#   - wisecode_gold.product
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional: max pool size for pg. Default 10. Match your DB's max_connections
# headroom; for a small dev / single-instance setup, 10 is plenty.
# DATABASE_POOL_MAX=10

# ─── AI provider keys ──────────────────────────────────────────────────────
# The "compose / tag" features in PreferencesPhone call an LLM through a
# small gateway (lib/llm.ts). Only the provider selected by LLM_PROVIDER
# needs to be set — but you can keep both keys here for easy switching.

# Selects which provider lib/llm.ts uses. Valid values: "openai", "anthropic".
# Default: "openai".
LLM_PROVIDER=openai

# OpenAI key. Required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-...

# Anthropic key. Required when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Defaults are gpt-5 (OpenAI) and
# claude-opus-4-7 (Anthropic). Set only if you want to pin a different
# model for cost or behavior reasons.
# OPENAI_MODEL=gpt-5
# ANTHROPIC_MODEL=claude-opus-4-7
