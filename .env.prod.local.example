# Copy to .env.prod.local (gitignored). Used by the "PN PWA — Prod" launch configs
# in .vscode/launch.json.
#
# Prefer read-only credentials for local debugging against production.
# URL-encode special characters in the password (# → %23, @ → %40, etc.):
#   node -e "console.log(encodeURIComponent(process.argv[1]))" 'raw-password'

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# DATABASE_POOL_MAX=10

LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
