# Copy to .env.uat.local (gitignored). Used by the "PN PWA — UAT" launch configs
# in .vscode/launch.json and when you need UAT Postgres / keys without touching
# .env.local.
#
# URL-encode special characters in the password (# → %23, @ → %40, etc.):
#   node -e "console.log(encodeURIComponent(process.argv[1]))" 'raw-password'

# PostgreSQL — UAT (wisecode_nhost is typical on Yellowjacket UAT RDS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/wisecode_nhost

# DATABASE_POOL_MAX=10

LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
